@page "/donnees"
@inherits ComposantLive
@inject OptionsPricer Options
@inject ServiceSession Session
@inject ServiceMarche Marche
@inject EtatApplication Etat
@inject NavigationManager Navigation

<PageTitle>Data and reading · Deribit Desk</PageTitle>
<div class="entete"><div><h1>Données &amp; lecture</h1><div class="muet">Choose the data, then apply your choice. The operations remain local: no order is sent to Deribit.</div></div></div>

<div class="grille g3">
    <div class="carte"><h2>Demonstration</h2><p>A fictional market, reproducible, to test all functions without connection.</p></div>
    <div class="carte"><h2>Registered market</h2><p>Ratings re-read from a file. The market is located on its date of registration.</p></div>
    <div class="carte"><h2>Direct Deribit</h2><p>Current public listings received via the Internet. Registration is optional.</p></div>
</div>

<div class="carte">
    <h2>Select Data</h2>
    <div class="formulaire">
        <div class="champ"><label for="mode-source">Data Mode</label><select id="mode-source" @bind="_mode"><option value="Demonstration">Fictive demonstration</option><option value="Rejeu">Registered market</option><option value="Live">Direct Deribit</option><option value="Enregistrement">Direct et enregistrement</option></select></div>
        <div class="champ"><label for="devise-source">Devise</label><select id="devise-source" @bind="_devise"><option>BTC</option><option>ETH</option></select></div>
    </div>
    @if(_mode==ModeDonnees.Rejeu)
    {
        <div class="champ" style="margin-top:12px"><label for="fichier-source">Registered file (.jsonl or .jsonl.gz)</label><input id="fichier-source" style="width:100%" @bind="_fichier" /></div>
        <p class="muet">The file must contain the selected currency. The actual file provided is in BTC.</p>
    }
    @if(_mode==ModeDonnees.Enregistrement)
    {
        <p class="muet">Public responses and ratings received will be recorded in a new file specific to this session.</p>
    }
    <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:16px">
        <button class="bouton" disabled="@Session.ChangementEnCours" @onclick="AppliquerAsync">@(Session.ChangementEnCours?"Chargement…":"Utiliser ces données")</button>
        <button class="bouton secondaire" disabled="@Session.ChangementEnCours" @onclick="NouvelleDemoAsync">Nouvelle démo @_devise</button>
        @if(_mode!=Options.Mode || _devise!=Options.Devise || (_mode==ModeDonnees.Rejeu && _fichier!=Options.FichierRejeu))
        { <span class="alerte-txt">Choice not applied: the banner always indicates the active source.</span> }
    </div>
    @if(_message is not null) { <p class="neg" role="alert">@_message</p> }
</div>

<div class="carte">
    <h2>How do I read a file?</h2>
    <p><strong>Pause lecture</strong>The calculations, graphs and booking are still available on this frozen market.</p>
    <p><strong>Next data</strong>a single recorded quote advance, then stay in pause. Several quotes can be carried the same time.</p>
    <p><strong>Vitesse ×1</strong> conserve les intervalles du fichier ; ×5 les parcourt cinq fois plus vite. Maximum termine la lecture dès que possible.</p>
    <p><strong>Restart</strong>starts at the beginning with a new book. The previous one remains saved in its separate file.</p>
    <p>These commands concern files and demonstration. Live, the market updates automatically.</p>
</div>

<details class="carte"><summary>Source Details and Backup</summary>
    <p>Source active : @Session.LibelleMode · @Options.Devise.</p>
    @if(Options.Mode==ModeDonnees.Rejeu) { <p>Fichier : <code>@Options.FichierRejeu</code></p> }
    @if(Options.Mode==ModeDonnees.Enregistrement) { <p>Enregistrement : <code>@Options.FichierEnregistrement</code></p> }
    <p>Book actif : <code>@Session.CheminBook</code></p>
    <p class="muet">Each operation is saved immediately. The next launch returns the active configuration and takes the file back to the last saved trade. Currency and source books remain separate.</p>
</details>

@code {
    private ModeDonnees _mode;
    private string _devise="BTC",_fichier="",_message="";
    /// <summary>
    /// Fill in the form with the active configuration without changing the source until the
    /// choice is applied.
    /// </summary>
    protected override void OnInitialized()
    {
        _mode=Options.Mode; _devise=Options.Devise; _fichier=Options.FichierRejeu;
        base.OnInitialized();
    }
    /// <summary>
    /// Apply the requested mode and currency, then reload the page after restoring the
    /// associated book.
    /// </summary>
    private async Task AppliquerAsync()
    {
        _message="";
        try
        {
            await Session.ChangerAsync(_mode,_devise,_fichier);
            Navigation.NavigateTo("",forceLoad:true);
        }
        catch(Exception ex) when(ex is IOException or PricerException or ArgumentException or HttpRequestException or UnauthorizedAccessException)
        { _message="Changement impossible : "+ex.Message; }
    }
    /// <summary>
    /// We open a new demonstration for the chosen currency with a separate book session.
    /// </summary>
    private async Task NouvelleDemoAsync()
    {
        _message="";
        try { await Session.ChangerAsync(ModeDonnees.Demonstration,_devise,_fichier,true); Navigation.NavigateTo("",forceLoad:true); }
        catch(Exception ex) when(ex is IOException or PricerException or ArgumentException or HttpRequestException) { _message=ex.Message; }
    }
}
