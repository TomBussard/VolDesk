@page "/pricer"
@inherits ComposantLive
@inject ServiceMarche Marche
@inject Blotter BlotterDesk

<PageTitle>Strategy pricer · VolDesk</PageTitle>

@{
    var etat = Marche.EtatCourant;
    var echeances = etat.Referentiel.Echeances.Where(e => e > etat.Maintenant).ToList();
    var strikes = _echeance == default ? new List<PaireStrike>() : etat.Referentiel.Strikes(_echeance).ToList();
}

<div class="entete">
    <div>
        <h1>Strategy pricer</h1>
        <div class="muet">Price each leg with Black-76, compare its implied volatility with the market and inspect the executable spread.</div>
    </div>
</div>

<Message @bind-Texte="_message" Type="@_typeMessage" />

<div class="carte">
    <div class="formulaire">
        <div class="champ">
            <label>Structure</label>
            <select value="@_type" @onchange="ChangerType">
                @foreach (var (t, r) in FabriqueStructures.Catalogue)
                {
                    <option value="@t">@r.Nom</option>
                }
                <option value="@TypeStructure.OptionSimple">Listed call or put</option>
            </select>
        </div>
        @if (_type == TypeStructure.OptionSimple)
        {
            <div class="champ">
                <label>Type</label>
                <div class="segmente">
                    <button class="@(_typeOption == TypeOption.Call ? "actif" : "")" @onclick="() => { _typeOption = TypeOption.Call; Invalider(); }">Call</button>
                    <button class="@(_typeOption == TypeOption.Put ? "actif" : "")" @onclick="() => { _typeOption = TypeOption.Put; Invalider(); }">Put</button>
                </div>
            </div>
        }
        <div class="champ">
            <label>Expiry</label>
            <select value="@_echeance.Ticks" @onchange="ChangerEcheance">
                @foreach (var e in echeances)
                {
                    <option value="@e.Ticks">@Format.Echeance(e)</option>
                }
            </select>
        </div>
        @for (int i = 0; i < NombreStrikes; i++)
        {
            int indice = i;
            <div class="champ">
                <label>Strike @(indice + 1)</label>
                <select @key="(_echeance, _type, indice)" value="@_strikes[indice].ToString(CultureInfo.InvariantCulture)" @onchange="e => { _strikes[indice] = double.Parse((string)e.Value!, CultureInfo.InvariantCulture); Invalider(); }">
                    @foreach (var p in strikes)
                    {
                        <option value="@p.Strike.ToString(CultureInfo.InvariantCulture)">@p.Strike.ToString("N0")</option>
                    }
                </select>
            </div>
        }
        <div class="champ">
            <label>Side</label>
            <div class="segmente">
                <button class="@(_sens == Sens.Achat ? "actif achat" : "")" @onclick="() => { _sens = Sens.Achat; Invalider(); }">Buy</button>
                <button class="@(_sens == Sens.Vente ? "actif vente" : "")" @onclick="() => { _sens = Sens.Vente; Invalider(); }">Sell</button>
            </div>
        </div>
        <div class="champ">
            <label>Quantity (step @PasQuantite.ToString("0.###"))</label>
            <input type="number" step="@PasQuantite.ToString(CultureInfo.InvariantCulture)" @bind="_quantite" @bind:after="Invalider" />
        </div>
        <button class="bouton" @onclick="CoterAsync">Get quote</button>
    </div>
</div>

@if (_cotation is { } c)
{
    <div class="carte">
        <h2>@c.Structure.Description · <span class="@(c.Sens == Sens.Achat ? "pos" : "neg")">@(c.Sens == Sens.Achat ? "BUY" : "SELL")</span> × @Format.Nombre(c.Quantite, "0.0") <span class="muet" style="font-weight:400">· @c.Horodatage.ToString("HH:mm:ss.fff") UTC</span></h2>
        <div class="tableau-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Leg</th><th>Qty</th><th>Future</th><th>σ mark</th><th>Model USD</th><th>Model @etat.Referentiel.Devise</th><th>Mark @etat.Referentiel.Devise</th><th>Difference @etat.Referentiel.Devise</th>
                        <th>Bid IV model / feed</th><th>Mark IV model / feed</th><th>Ask IV model / feed</th><th>Bid</th><th>Ask</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in c.Lignes)
                    {
                        <tr>
                            <td>@l.Jambe.Libelle</td>
                            <td class="@Format.ClasseSigne(l.QuantiteSignee)">@Format.Signe(l.QuantiteSignee, 1)</td>
                            <td>@Format.Usd(l.Parametres.Future)</td>
                            <td>@Format.Pct(l.Parametres.Sigma)</td>
                            <td>@Format.Usd(l.Theorique.PrixUsd)</td>
                            <td>@Format.Btc(l.Theorique.PrixBtc)</td>
                            <td>@Format.Btc(l.Cotation?.Mark, 4)</td>
                            <td class="@(l.EcartMarkSignale ? "signale" : "")">@Format.Signe(l.EcartMarkBtc, 6)</td>
                            <Vol C="l.VolBid" /><Vol C="l.VolMark" /><Vol C="l.VolAsk" />
                            <td>@Format.Btc(l.Cotation?.Bid, 4)</td>
                            <td>@Format.Btc(l.Cotation?.Ask, 4)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="muet" style="font-size:12px;margin-top:8px">Highlighted differences exceed 0.0001 @etat.Referentiel.Devise in price or 0.1 volatility points.</div>
    </div>

    <div class="grille g2">
        <div class="carte">
            <h2>Strategy price <span class="muet">(per unit)</span></h2>
            <div class="ligne-prix">
                <span class="lib"></span><span class="lib">@etat.Referentiel.Devise</span><span class="lib">USD</span>
                <span class="lib">Model (Black-76)</span><span>@Format.Btc(c.TheoriqueUnitaireBtc)</span><span>@Format.Usd(c.TheoriqueUnitaireUsd)</span>
                <span class="lib">Market mark</span><span>@Format.Btc(c.MarkUnitaireBtc)</span><span>@Format.Usd(c.MarkUnitaireBtc * c.Future)</span>
                @if (c.Traitable)
                {
                    <span class="lib pos">Buy at the ask</span><span>@Format.Btc(c.PrixExecutableAchatBtc)</span><span>@Format.Usd(c.PrixExecutableAchatBtc * c.Future)</span>
                    <span class="lib neg">Sell at the bid</span><span>@Format.Btc(c.PrixExecutableVenteBtc)</span><span>@Format.Usd(c.PrixExecutableVenteBtc * c.Future)</span>
                    <span class="lib">Bid/ask spread</span><span>@Format.Btc(c.FourchetteBtc)</span><span>@Format.Usd(c.FourchetteBtc * c.Future)</span>
                    <span class="lib fort">Total premium (@(c.Sens == Sens.Achat ? "buy" : "sell"))</span><span class="fort">@Format.Btc(c.PrimeTotaleBtc)</span><span class="fort">@Format.Usd(c.PrimeTotaleBtc * c.Future)</span>
                }
                else
                {
                    <span class="lib alerte-txt">Quote unavailable</span><span class="alerte-txt" style="grid-column: span 2">A leg is missing a two-sided quote or its market is closed.</span>
                }
            </div>
            <div style="display:flex; gap:8px; margin-top:16px">
                <button class="bouton vert" disabled="@(!c.Traitable)" @onclick="Booker">Book simulated trade</button>
                <button class="bouton secondaire" @onclick="() => _afficherProfil = !_afficherProfil">@(_afficherProfil ? "Hide" : "Show") scenarios and sensitivities</button>
            </div>
        </div>
        <div class="carte">
            <h2>Strategy Greeks</h2>
            <table>
                <thead><tr><th>Greek</th><th>Black-76</th><th>Deribit</th><th>Difference</th></tr></thead>
                <tbody>
                    <LigneGrecque Nom="Delta" Nous="c.Grecques.Delta" Deribit="c.GrecquesDeribit?.Delta" Motif="0.0000" />
                    <LigneGrecque Nom="Gamma" Nous="c.Grecques.Gamma" Deribit="c.GrecquesDeribit?.Gamma" Motif="0.000000" />
                    <LigneGrecque Nom="Vega (USD / vol point)" Nous="c.Grecques.Vega" Deribit="c.GrecquesDeribit?.Vega" Motif="0.00" />
                    <LigneGrecque Nom="Theta (USD / day)" Nous="c.Grecques.Theta" Deribit="c.GrecquesDeribit?.Theta" Motif="0.00" />
                </tbody>
            </table>
        </div>
    </div>

    @if (_afficherProfil && c.Traitable)
    {
        <PanneauScenarios Cotation="c" />
    }

}
else if (_erreurCotation is not null)
{
    <div class="message message-erreur">@_erreurCotation</div>
}

@code {
    private TypeStructure _type = TypeStructure.CallSpread;
    private TypeOption _typeOption = TypeOption.Call;
    private DateTime _echeance;
    private readonly double[] _strikes = new double[3];
    private Sens _sens = Sens.Achat;
    private double _quantite = 1;
    private Structure? _structure;
    private Sens _sensCote;
    private double _quantiteCotee;
    private CotationStructure? _cotation;
    private bool _afficherProfil = true;
    private string? _message, _typeMessage = "info", _erreurCotation;

    private double PasQuantite => Marche.EtatCourant.Referentiel.Devise == "ETH" ? 1 : 0.1;
    private int NombreStrikes => _type == TypeStructure.OptionSimple ? 1 : FabriqueStructures.Catalogue[_type].NombreStrikes;

    /// <summary>
    /// A still open maturity is chosen and strings near the money are chosen to prepare
    /// a first quote.
    /// </summary>
    protected override void OnInitialized()
    {
        var etat = Marche.EtatCourant;
        _echeance = etat.Referentiel.Echeances.FirstOrDefault(e => (e - etat.Maintenant).TotalDays > 1.5, etat.Referentiel.Echeances.FirstOrDefault(e => e > etat.Maintenant));
        StrikesParDefaut();
        base.OnInitialized();
    }

    /// <summary>
    /// The number and values of the strikes are adjusted to the new recipe and the previous
    /// rating is removed.
    /// </summary>
    private void ChangerType(ChangeEventArgs e)
    {
        _type = Enum.Parse<TypeStructure>((string)e.Value!);
        StrikesParDefaut();
        Invalider();
    }

    /// <summary>
    /// Strikes listed on the new expiry are selected and the result obtained on the old one
    /// is invalidated.
    /// </summary>
    private void ChangerEcheance(ChangeEventArgs e)
    {
        _echeance = new DateTime(long.Parse((string)e.Value!), DateTimeKind.Utc);
        StrikesParDefaut();
        Invalider();
    }

    /// <summary>
    /// Strikes around the future are proposed to start with a structure near the money;
    /// the user can then change these values.
    /// </summary>
    private void StrikesParDefaut()
    {
        var etat = Marche.EtatCourant;
        if (_echeance == default) return;
        var liste = etat.Referentiel.Strikes(_echeance).Select(p => p.Strike).ToList();
        double f = etat.Future(_echeance) ?? liste[liste.Count / 2];
        int atm = liste.IndexOf(liste.OrderBy(k => Math.Abs(k - f)).First());
        double K(int i) => liste[Math.Clamp(i, 0, liste.Count - 1)];
        (_strikes[0], _strikes[1], _strikes[2]) = NombreStrikes switch
        {
            1 => (K(atm), K(atm + 2), K(atm + 4)),
            2 when _type is TypeStructure.PutSpread or TypeStructure.RiskReversal or TypeStructure.Strangle => (K(atm - 2), K(atm + (_type == TypeStructure.PutSpread ? 0 : 2)), K(atm + 4)),
            2 => (K(atm), K(atm + 2), K(atm + 4)),
            _ => (K(atm - 2), K(atm), K(atm + 2))
        };
    }

    /// <summary>
    /// The input is checked, the instruments of the structure are monitored, and the executable
    /// prices are calculated before processing.
    /// </summary>
    private async Task CoterAsync()
    {
        _message = null;
        _cotation = null;
        _structure = null;
        try
        {
            var etat = Marche.EtatCourant;
            var structure = _type == TypeStructure.OptionSimple
                ? FabriqueStructures.CreerOptionSimple(_typeOption, _echeance, _strikes[0], etat.Referentiel)
                : FabriqueStructures.Creer(_type, _echeance, _strikes.Take(NombreStrikes).ToList(), etat.Referentiel);
            ValidateurStructure.ValiderQuantite(_quantite, PasQuantite);
            (_structure, _sensCote, _quantiteCotee) = (structure, _sens, _quantite);
            await Marche.SuivreAsync(structure.Jambes.OfType<ICotableSurMarche>().Select(j => j.Instrument.Nom));
            Recalculer();
        }
        catch (SaisieInvalideException ex) { Afficher($"Input rejected (code {(int)ex.CodeErreur}) : {ex.Message}", "erreur"); }
        catch (PricerException ex) { Afficher(ex.Message, "erreur"); }
    }

    /// <summary>
    /// The frozen structure is updated with the last market and the rating is removed if the
    /// data no longer allow calculation.
    /// </summary>
    private void Recalculer()
    {
        if (_structure is null) return;
        try
        {
            var etat = Marche.EtatCourant;
            _cotation = PricerStructure.Coter(_structure, _sensCote, _quantiteCotee, etat);
            _erreurCotation = null;
        }
        catch (PricerException ex)
        {
            _cotation = null;
            _erreurCotation = ex.Message;
        }
    }

    /// <summary>
    /// The quote is recalculated prior to periodic posting to ensure that prices and risks
    /// follow the market.
    /// </summary>
    protected override Task AvantRafraichissementAsync()
    {
        Recalculer();
        return Task.CompletedTask;
    }

    /// <summary>
    /// We are going back to the current market before we record the trade and its performances
    /// in the floater.
    /// </summary>
    private void Booker()
    {
        try
        {
            var t = BlotterDesk.Booker(PricerStructure.Coter(_structure!, _sensCote, _quantiteCotee, Marche.EtatCourant));
            Afficher($"Trade {t.Id.ToString()[..8]} booked. {t.Description}, premium {Format.Btc(t.PrimeBtc)} {Marche.EtatCourant.Referentiel.Devise}. See the blotter and positions.", "succes");
        }
        catch (PricerException ex) { Afficher(ex.Message, "erreur"); }
    }

    /// <summary>
    /// The structure and its results are removed as soon as the input changes to avoid
    /// processing an old application.
    /// </summary>
    private void Invalider()
    {
        // The old result is removed when a input changes, not to treat another structure by mistake.
        _cotation = null;
        _structure = null;
        _erreurCotation = null;
    }

    /// <summary>
    /// The text and level of the message presented under the form are selected.
    /// </summary>
    private void Afficher(string texte, string type) => (_message, _typeMessage) = (texte, type);
}
