@page "/"
@inherits ComposantLive
@inject ServiceMarche Marche
@inject Pricer.Domaine.Booking.Book BookDesk
@inject OptionsPricer Options
@inject ServiceSession Session

<PageTitle>Market overview · VolDesk</PageTitle>

@{
    var etat = Marche.EtatCourant;
    var book = BookDesk.Evaluer(etat);
    var echeance = etat.Referentiel.Echeances.FirstOrDefault(e => (e - etat.Maintenant).TotalDays > 1.5 && etat.Smiles().Any(s => s.Echeance == e));
    var smile = etat.Smiles().FirstOrDefault(s => s.Echeance == echeance);
}

<div class="entete">
    <div>
        <h1>Market overview</h1>
        <div class="muet">@Options.Devise options · @Session.LibelleMode · @etat.Maintenant.ToString("dd/MM/yyyy HH:mm:ss") UTC</div>
    </div>
    <div style="display:flex; gap:8px">
        <a class="bouton" href="pricer">Price a strategy</a>
        <a class="bouton secondaire" href="sur-mesure">Custom option</a>
    </div>
</div>

<div class="grille g4">
    <div class="kpi"><div class="libelle">@Options.Devise/USD index</div><div class="valeur">@Format.Usd(etat.Indice)</div><div class="detail">@etat.Referentiel.NombreOptions options · @etat.Referentiel.Echeances.Count expiries</div></div>
    <div class="kpi"><div class="libelle">Total book P&amp;L</div><div class="valeur @Format.ClasseSigne(book.PnlTotalBtc)">@Format.Signe(book.PnlTotalBtc, 6) @Options.Devise</div><div class="detail">@Format.Usd(book.PnlTotalUsd) USD · realised @Format.Btc(book.PnlRealiseBtc)</div></div>
    <div class="kpi"><div class="libelle">Open positions</div><div class="valeur">@book.Ouvertes.Count()</div><div class="detail">@BookDesk.Blotter.Trades.Count recorded trades</div></div>
    <div class="kpi"><div class="libelle">Net book delta</div><div class="valeur">@Format.Nombre(book.GrecquesTotales.Delta, "0.000")</div><div class="detail">vega @Format.Nombre(book.GrecquesTotales.Vega, "N1") $/pt · theta @Format.Nombre(book.GrecquesTotales.Theta, "N1") $/day</div></div>
</div>

@if (!book.ValorisationComplete || !book.RisqueComplet)
{
    <div class="message message-info" role="status">Some positions have incomplete market data. See Positions and risk for the affected values.</div>
}

<div class="carte aide-accueil">
    <b>From quote to position</b>
    <span>1. Choose a source under <a href="donnees">Market data and replay</a>.</span>
    <span>2. Build a listed strategy or specify a custom contract.</span>
    <span>3. Check the price, scenarios and hedge before booking.</span>
    <span class="muet">All trades in this desk are simulated and stored locally.</span>
</div>

<div class="grille g2" style="margin-top:16px">
    <div class="carte">
        <h2>Volatility smile @(echeance == default ? "" : Format.Court(echeance)) <span class="muet">· Black-76 implied volatility</span></h2>
        <GraphiqueSmile Smile="smile" />
    </div>
    <div class="carte">
        <h2>Term structure</h2>
        <div class="tableau-wrap">
            <table>
                <thead><tr><th>Expiry</th><th>Days</th><th>Future</th><th>ATM IV</th><th>Smile points</th></tr></thead>
                <tbody>
                    @foreach (var s in etat.Smiles().Take(12))
                    {
                        <tr>
                            <td>@Format.Court(s.Echeance)</td>
                            <td>@Format.Nombre(s.Maturite * 365, "0.0")</td>
                            <td>@Format.Usd(s.Future)</td>
                            <td>@VolAtm(s)</td>
                            <td>@s.Points.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Interpolate at zero log-moneyness to read the at-the-money volatility.
    /// </summary>
    private static string VolAtm(SmileEcheance s)
    {
        try { return Format.Pct(Interpolateur.VolSurEcheance(s, 0)); }
        catch (HorsPlageException) { return "—"; }
    }
}
