@* We put our recalculated and Deribit volatility side by side, and then we report the deviations greater than 0.1 points. *@
<td class="@(C?.Signale == true ? "signale" : "")">
    @if (C is null) { <span class="muet">—</span> }
    else if (!C.Calculee.EstCalculee) { <span class="alerte-txt">@C.Calculee.Libelle</span> }
    else { @Format.Nombre(C.Calculee.Sigma * 100, "0.00") <span class="muet"> / @Format.Nombre(C.Deribit, "0.00")</span> }
</td>

@code {
    [Parameter] public ComparaisonVol? C { get; set; }
}
