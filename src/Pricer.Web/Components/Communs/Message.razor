@if (!string.IsNullOrEmpty(Texte))
{
    <div class="message message-@Type">
        <span>@Texte</span>
        <button class="fermer" @onclick="Fermer" aria-label="Dismiss message">Dismiss</button>
    </div>
}

@code {
    [Parameter] public string? Texte { get; set; }
    [Parameter] public string Type { get; set; } = "info";
    [Parameter] public EventCallback<string?> TexteChanged { get; set; }

    /// <summary>
    /// The parent is advised that the message is closed so that it erases the text.
    /// </summary>
    private Task Fermer() => TexteChanged.InvokeAsync(null);
}
