@inherits LayoutComponentBase
@implements IDisposable
@inject ServiceMarche Marche
@inject OptionsPricer Options
@inject EtatApplication Etat
@inject ServiceSession Session
@inject NavigationManager Navigation

<div class="app">
    <aside class="barre">
        <div class="logo">
            <span class="logo-icone">Δ</span>
            <div>
                <div class="logo-titre">VolDesk</div>
                <div class="logo-sous">@Options.Devise options</div>
            </div>
        </div>
        <nav>
            <NavLink href="" Match="NavLinkMatch.All">Market overview</NavLink>
            <NavLink href="referentiel">Option chain</NavLink>
            <NavLink href="pricer">Strategy pricer</NavLink>
            <NavLink href="sur-mesure">Custom option</NavLink>
            <NavLink href="book">Positions and risk</NavLink>
            <NavLink href="blotter">Trade blotter</NavLink>
            <NavLink href="exports">Exports</NavLink>
            <NavLink href="donnees">Market data and replay</NavLink>
        </nav>
        <div class="statut">
            <div class="mode mode-@Options.Mode.ToString().ToLowerInvariant()">@Session.LibelleMode</div>
            @if (Etat.Erreur is not null)
            {
                <div class="neg">Startup error</div>
            }
            else if (!Etat.Pret)
            {
                <div class="muet">Loading market data…</div>
            }
            else
            {
                <div class="muet">@Marche.EtatCourant.Maintenant.ToString("dd/MM HH:mm:ss") UTC</div>
                <div class="muet">@Marche.MessagesRecus.ToString("N0") ticks @(Marche.FluxTermine ? "· replay complete" : "")</div>
                <div class="muet">Index $@Format.Usd(Marche.EtatCourant.Indice)</div>
            }
        </div>
    </aside>
    <main class="contenu">
        @if(Options.AvertissementSession is not null) { <p class="alerte-txt" role="alert">@Options.AvertissementSession</p> }
        @if (Etat.Pret)
        {
            <div class="carte bandeau-lecture" style="margin-bottom:20px">
                <div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap">
                    <div>
                        <strong>@Session.LibelleMode · @Options.Devise</strong>
                        <div class="muet">@DescriptionSource</div>
                    </div>
                    <div><strong>@EtatLecture</strong><div class="muet">Market time @Marche.EtatCourant.Maintenant.ToString("dd/MM/yyyy HH:mm:ss.fff") UTC</div></div>
                </div>
                @if (Marche.Rejeu is { } r)
                {
                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:12px">
                        <button class="bouton secondaire petit" disabled="@(r.FluxTermine || Session.ChangementEnCours)" @onclick="Pause">@(r.Lecture.EnPause ? "Resume" : "Pause replay")</button>
                        <button class="bouton secondaire petit" disabled="@(r.FluxTermine || Session.ChangementEnCours)" @onclick="Suivante">Next tick</button>
                        <label for="vitesse-lecture">Speed</label>
                        <select id="vitesse-lecture" style="min-width:100px;width:115px" value="@r.Lecture.Vitesse.ToString(CultureInfo.InvariantCulture)" @onchange="Vitesse">
                            <option value="1">×1 · normal</option><option value="5">×5</option><option value="20">×20</option><option value="100">×100</option><option value="0">Maximum</option>
                        </select>
                        <button class="bouton secondaire petit" disabled="@Session.ChangementEnCours" @onclick="Recommencer">Restart</button>
                        <a href="donnees">Playback guide</a>
                    </div>
                }
                @if (_erreur is not null) { <div class="neg" role="alert">@_erreur</div> }
                @if (Session.ErreurSauvegarde is not null) { <div class="neg" role="alert">@Session.ErreurSauvegarde</div> }
            </div>
        }
        @if (Etat.Erreur is not null)
        {
            <div class="carte alerte">
                <h2>Market unavailable</h2>
                <p>@Etat.Erreur</p>
                <p class="muet">Select the offline session under <a href="donnees">Market data and replay</a>.</p>
            </div>
        }
        else if (!Etat.Pret)
        {
            <div class="chargement"><div class="spinner"></div>Loading options for @Options.Devise (@Options.Mode)…</div>
        }
        @if (Etat.Pret || Navigation.Uri.TrimEnd('/').EndsWith("/donnees",StringComparison.OrdinalIgnoreCase))
        {
            <div @key="Options.CleBookSession">@Body</div>
        }
    </main>
</div>

@code {
    private Timer? _minuteur;
    private string? _erreur;
    private string DescriptionSource => Options.Mode switch
    {
        ModeDonnees.Demonstration => "Model-generated quotes for the offline session.",
        ModeDonnees.Rejeu => "Recorded quotes. The clock follows the original session.",
        _ => "Public Deribit market data."
    };
    private string EtatLecture => Marche.ErreurFlux is not null ? "Playback interrupted" : Marche.Rejeu is { } r ?
        r.FluxTermine ? "End of replay" : r.Lecture.EnPause ? "Paused" : "Playing" : "Updating automatically";
    /// <summary>
    /// We switch between pause and file recovery without changing the market already received.
    /// </summary>
    private void Pause()
    {
        if(Marche.Rejeu is not { } r) return;
        if(r.Lecture.EnPause) r.Lecture.Reprendre(); else r.Lecture.Pause();
    }
    /// <summary>
    /// An additional ticker is allowed and the reading is left on pause to examine its effect.
    /// </summary>
    private void Suivante() => Marche.Rejeu?.Lecture.DonneeSuivante();
    /// <summary>
    /// The choice of menu is transformed into a speed factor and transmitted to the session
    /// service.
    /// </summary>
    private void Vitesse(ChangeEventArgs e)
    {
        if(double.TryParse((string?)e.Value,NumberStyles.Float,CultureInfo.InvariantCulture,out double v)) Session.Vitesse(v);
    }
    /// <summary>
    /// You create a new playback session and keep the error message if the restart fails.
    /// </summary>
    private async Task Recommencer()
    {
        _erreur=null;
        try { await Session.RecommencerAsync(); Navigation.NavigateTo("",forceLoad:true); }
        catch(Exception ex) when(ex is IOException or PricerException or ArgumentException or HttpRequestException) { _erreur=ex.Message; }
    }

    /// <summary>
    /// You can subscribe to changes in the boot state to update the page banner.
    /// </summary>
    protected override void OnInitialized()
    {
        Etat.Change += Rafraichir;
        _minuteur = new Timer(_ => Rafraichir(), null, 1000, 1000);
    }

    /// <summary>
    /// Refreshing of the banner is requested on the Blazor display context.
    /// </summary>
    private void Rafraichir() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// The shared status subscription is removed when the layout is destroyed.
    /// </summary>
    public void Dispose()
    {
        Etat.Change -= Rafraichir;
        _minuteur?.Dispose();
    }
}
